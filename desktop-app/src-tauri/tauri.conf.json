{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Robot6DOF Digital Twin",
  "version": "1.0.0",
  "identifier": "com.marco.robot6dof",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Robot 6 DOF — Digital Twin",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../Marco-Codici-6-DOF-main": "project"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
